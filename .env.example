# =============================================================================
# G-TEC Computer Education - Tripunithura Campus
# Environment Variables & Supabase Database Configuration
# =============================================================================

# Server Port
PORT=8080

# Supabase Project Credentials
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: Set to 'supabase' to strictly enforce Supabase or 'auto' for automatic hybrid fallback
DATABASE_MODE=auto
